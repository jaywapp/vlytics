# Copy values into an external secret manager or an untracked environment file.
# Every __REQUIRED__ value must be replaced before production activation.
VLYTICS_BACKEND_IMAGE=__REQUIRED__
VLYTICS_FRONTEND_IMAGE=__REQUIRED__
VLYTICS_NODE_BUILD_IMAGE=__REQUIRED__
VLYTICS_NGINX_RUNTIME_IMAGE=__REQUIRED__
VLYTICS_POSTGRES_IMAGE=postgres:17.11-alpine
VLYTICS_OPERATIONAL_CONFIG_FILE=./operational.production.example.toml
VLYTICS_LIVE_DRY_RUN_EVIDENCE_FILE=./live-dry-run-evidence.example.json
WEB_PORT=8080
POSTGRES_DB=vlytics

MIGRATOR_DATABASE_PASSWORD=__REQUIRED__
COLLECTOR_DATABASE_PASSWORD=__REQUIRED__
ENGINE_DATABASE_PASSWORD=__REQUIRED__
MARKET_INGEST_DATABASE_PASSWORD=__REQUIRED__
READ_API_DATABASE_PASSWORD=__REQUIRED__

MIGRATOR_DATABASE_URL=__REQUIRED__
COLLECTOR_DATABASE_URL=__REQUIRED__
ENGINE_DATABASE_URL=__REQUIRED__
MARKET_INGEST_DATABASE_URL=__REQUIRED__
READ_API_DATABASE_URL=__REQUIRED__

VLYTICS_OPERATOR_AUTH_SECRET=__REQUIRED__
VLYTICS_READONLY_AUTH_SECRET=__REQUIRED__
VLYTICS_BACKUP_CREDENTIAL=__REQUIRED__
VLYTICS_ALERT_DESTINATION=__REQUIRED__
VLYTICS_OPENAI_API_KEY=__REQUIRED__
VLYTICS_ANTHROPIC_API_KEY=__REQUIRED__
VLYTICS_GOOGLE_API_KEY=__REQUIRED__
