{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vlytics:prediction-output:1",
  "title": "Vlytics PredictionOutputV1",
  "description": "A versioned probability output. Set outcomes are ordered from 3:0 through 0:3 from the home-team perspective.",
  "$comment": "A server semantic validator enforces probability sums, winner/set marginal consistency, capability/provenance agreement, and ownership of joint_score_distribution_ref.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_variant_id",
    "model_version",
    "distribution_version",
    "capabilities",
    "target_provenance",
    "rationale",
    "risk_factors"
  ],
  "properties": {
    "schema_version": { "const": "prediction-v1" },
    "producer_variant_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "distribution_version": { "type": "string", "minLength": 1 },
    "config_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "random_seed": { "type": "integer" },
    "division": { "enum": ["men", "women"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["winner", "set_score", "point_handicap", "point_total"]
      }
    },
    "home_win_probability": { "$ref": "#/$defs/probability" },
    "set_score_probabilities": { "$ref": "#/$defs/setScoreProbabilities" },
    "joint_score_distribution_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Server-owned ID for a validated distribution from this snapshot and variant."
    },
    "target_provenance": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "winner": { "$ref": "#/$defs/provenance" },
        "set_score": { "$ref": "#/$defs/provenance" },
        "point_handicap": { "$ref": "#/$defs/provenance" },
        "point_total": { "$ref": "#/$defs/provenance" }
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "risk_factors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "confidence_note": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "winner" } } },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["home_win_probability"],
        "properties": { "target_provenance": { "required": ["winner"] } }
      }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "set_score" } } },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["home_win_probability", "set_score_probabilities"],
        "properties": { "target_provenance": { "required": ["set_score"] } }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": { "enum": ["point_handicap", "point_total"] }
          }
        },
        "required": ["capabilities"]
      },
      "then": { "required": ["joint_score_distribution_ref"] }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "point_handicap" } } },
        "required": ["capabilities"]
      },
      "then": {
        "properties": { "target_provenance": { "required": ["point_handicap"] } }
      }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "point_total" } } },
        "required": ["capabilities"]
      },
      "then": {
        "properties": { "target_provenance": { "required": ["point_total"] } }
      }
    }
  ],
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_variant_id",
        "distribution_version",
        "probability_source",
        "derivation_method",
        "input_snapshot_id"
      ],
      "properties": {
        "producer_variant_id": { "type": "string", "minLength": 1 },
        "distribution_version": { "type": "string", "minLength": 1 },
        "probability_source": {
          "enum": ["ai_direct", "statistical_derived", "hybrid_derived"]
        },
        "derivation_method": { "type": "string", "minLength": 1 },
        "input_snapshot_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "upstream_prediction_id": { "type": "string", "minLength": 1 },
        "upstream_model_version": { "type": "string", "minLength": 1 },
        "upstream_config_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fitted_parameter_artifact_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "training_cohort": { "$ref": "#/$defs/trainingCohort" },
        "training_as_of": { "type": "string", "format": "date-time" },
        "training_result_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_set_prediction_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_set_producer_variant_id": { "type": "string", "minLength": 1 },
        "source_set_model_version": { "type": "string", "minLength": 1 },
        "source_set_config_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "trainingCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "division",
        "availability_policy",
        "competition",
        "stage",
        "timing_eligibility",
        "result_finality_policy",
        "input_version",
        "franchise_mapping_version"
      ],
      "properties": {
        "division": { "enum": ["men", "women"] },
        "availability_policy": {
          "enum": ["historical_reconstruction", "historical_point_in_time", "live_prospective"]
        },
        "competition": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "timing_eligibility": { "enum": ["on_time", "reconstructed"] },
        "result_finality_policy": { "const": "final_only" },
        "input_version": { "type": "string", "minLength": 1 },
        "franchise_mapping_version": { "type": "string", "minLength": 1 }
      }
    },
    "setScoreProbabilities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/outcome30" },
        { "$ref": "#/$defs/outcome31" },
        { "$ref": "#/$defs/outcome32" },
        { "$ref": "#/$defs/outcome23" },
        { "$ref": "#/$defs/outcome13" },
        { "$ref": "#/$defs/outcome03" }
      ],
      "items": false
    },
    "outcomeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "probability"],
      "properties": {
        "outcome": { "type": "string" },
        "probability": { "$ref": "#/$defs/probability" }
      }
    },
    "outcome30": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "3:0" } } }
      ]
    },
    "outcome31": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "3:1" } } }
      ]
    },
    "outcome32": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "3:2" } } }
      ]
    },
    "outcome23": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "2:3" } } }
      ]
    },
    "outcome13": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "1:3" } } }
      ]
    },
    "outcome03": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "0:3" } } }
      ]
    }
  }
}
