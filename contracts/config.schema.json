{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vlytics:config-schema:1",
  "title": "Vlytics operational configuration",
  "description": "Runtime configuration contract. Secrets are referenced by environment variable name and are never stored in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "live_operations_enabled",
    "deployment",
    "database",
    "backup",
    "alerting",
    "ai",
    "timing",
    "results",
    "source",
    "activation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "environment": {
      "enum": [
        "example",
        "development",
        "staging",
        "production"
      ]
    },
    "live_operations_enabled": {
      "type": "boolean",
      "description": "Master safety gate. Production workers must refuse to start when this is false."
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "database": {
      "$ref": "#/$defs/database"
    },
    "backup": {
      "$ref": "#/$defs/backup"
    },
    "alerting": {
      "$ref": "#/$defs/alerting"
    },
    "ai": {
      "$ref": "#/$defs/ai"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "results": {
      "$ref": "#/$defs/results"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "activation": {
      "$ref": "#/$defs/activation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "live_operations_enabled": {
            "const": true
          }
        },
        "required": [
          "live_operations_enabled"
        ]
      },
      "then": {
        "properties": {
          "environment": {
            "enum": [
              "staging",
              "production"
            ]
          },
          "deployment": {
            "properties": {
              "live_enabled": {
                "const": true
              }
            }
          },
          "backup": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "alerting": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "ai": {
            "properties": {
              "live_calls_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "configuredString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "__REQUIRED__",
          "__REQUIRED_BY_OP_001__",
          "__REQUIRED_SECRET__",
          "CHANGE_ME",
          "UNCONFIGURED"
        ]
      }
    },
    "environmentVariableName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "not": {
        "enum": [
          "UNCONFIGURED",
          "REQUIRED",
          "REQUIRED_SECRET"
        ]
      }
    },
    "currencyCode": {
      "allOf": [
        {
          "$ref": "#/$defs/configuredString"
        },
        {
          "pattern": "^[A-Z]{3}$"
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_enabled",
        "host_class",
        "host_provider",
        "host_region",
        "monthly_cost_limit",
        "cost_currency",
        "network_access",
        "operator_auth_method",
        "operator_secret_env",
        "clock_sync_required"
      ],
      "properties": {
        "live_enabled": {
          "type": "boolean"
        },
        "host_class": {
          "enum": [
            "unconfigured",
            "managed_vm_and_database",
            "private_single_vm",
            "dedicated_private_machine"
          ]
        },
        "host_provider": {
          "type": "string",
          "minLength": 1
        },
        "host_region": {
          "type": "string",
          "minLength": 1
        },
        "monthly_cost_limit": {
          "type": "number",
          "minimum": 0
        },
        "cost_currency": {
          "type": "string",
          "minLength": 1
        },
        "network_access": {
          "enum": [
            "unconfigured",
            "loopback",
            "private_network"
          ]
        },
        "operator_auth_method": {
          "enum": [
            "unconfigured",
            "private_network_identity",
            "reverse_proxy_oidc",
            "mutual_tls"
          ]
        },
        "operator_secret_env": {
          "$ref": "#/$defs/environmentVariableName"
        },
        "clock_sync_required": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "live_enabled": {
                "const": true
              }
            },
            "required": [
              "live_enabled"
            ]
          },
          "then": {
            "properties": {
              "host_class": {
                "enum": [
                  "managed_vm_and_database",
                  "private_single_vm",
                  "dedicated_private_machine"
                ]
              },
              "host_provider": {
                "$ref": "#/$defs/configuredString"
              },
              "host_region": {
                "$ref": "#/$defs/configuredString"
              },
              "monthly_cost_limit": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cost_currency": {
                "$ref": "#/$defs/currencyCode"
              },
              "network_access": {
                "enum": [
                  "loopback",
                  "private_network"
                ]
              },
              "operator_auth_method": {
                "enum": [
                  "private_network_identity",
                  "reverse_proxy_oidc",
                  "mutual_tls"
                ]
              }
            }
          }
        }
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "connection_url_env",
        "raw_storage"
      ],
      "properties": {
        "engine": {
          "const": "postgresql"
        },
        "connection_url_env": {
          "$ref": "#/$defs/environmentVariableName"
        },
        "raw_storage": {
          "enum": [
            "postgresql_private",
            "private_object_storage"
          ]
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "strategy",
        "interval_hours",
        "retention_days",
        "rpo_minutes",
        "rto_minutes",
        "credential_env"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "interval_hours": {
          "type": "integer",
          "minimum": 0
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "rpo_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "rto_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "credential_env": {
          "$ref": "#/$defs/environmentVariableName"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "strategy": {
                "$ref": "#/$defs/configuredString"
              },
              "interval_hours": {
                "type": "integer",
                "minimum": 1
              },
              "retention_days": {
                "type": "integer",
                "minimum": 1
              },
              "rpo_minutes": {
                "type": "integer",
                "minimum": 1
              },
              "rto_minutes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "alerting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "channel",
        "destination_env"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "destination_env": {
          "$ref": "#/$defs/environmentVariableName"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "channel": {
                "$ref": "#/$defs/configuredString"
              }
            }
          }
        }
      ]
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_calls_enabled",
        "budget_currency",
        "openai",
        "anthropic",
        "google"
      ],
      "properties": {
        "live_calls_enabled": {
          "type": "boolean"
        },
        "budget_currency": {
          "type": "string",
          "minLength": 1
        },
        "openai": {
          "$ref": "#/$defs/provider"
        },
        "anthropic": {
          "$ref": "#/$defs/provider"
        },
        "google": {
          "$ref": "#/$defs/provider"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "live_calls_enabled": {
                "const": true
              }
            },
            "required": [
              "live_calls_enabled"
            ]
          },
          "then": {
            "properties": {
              "budget_currency": {
                "$ref": "#/$defs/currencyCode"
              },
              "openai": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "anthropic": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "google": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "model_id",
        "version_policy",
        "pinned_model_version",
        "api_key_env",
        "daily_budget_amount",
        "monthly_budget_amount",
        "max_calls_per_match",
        "daily_call_limit",
        "monthly_call_limit",
        "max_input_tokens_per_call",
        "max_output_tokens_per_call"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "version_policy": {
          "enum": [
            "unconfigured",
            "immutable_model_id",
            "verify_resolved_model_id"
          ]
        },
        "pinned_model_version": {
          "type": "string",
          "minLength": 1
        },
        "api_key_env": {
          "$ref": "#/$defs/environmentVariableName"
        },
        "daily_budget_amount": {
          "type": "number",
          "minimum": 0
        },
        "monthly_budget_amount": {
          "type": "number",
          "minimum": 0
        },
        "max_calls_per_match": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "daily_call_limit": {
          "type": "integer",
          "minimum": 0
        },
        "monthly_call_limit": {
          "type": "integer",
          "minimum": 0
        },
        "max_input_tokens_per_call": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens_per_call": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "model_id": {
                "$ref": "#/$defs/configuredString"
              },
              "version_policy": {
                "enum": [
                  "immutable_model_id",
                  "verify_resolved_model_id"
                ]
              },
              "pinned_model_version": {
                "$ref": "#/$defs/configuredString"
              },
              "daily_budget_amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "monthly_budget_amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_calls_per_match": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "daily_call_limit": {
                "type": "integer",
                "minimum": 1
              },
              "monthly_call_limit": {
                "type": "integer",
                "minimum": 1
              },
              "max_input_tokens_per_call": {
                "type": "integer",
                "minimum": 1
              },
              "max_output_tokens_per_call": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_cutoff_minutes",
        "initial_start_tolerance_seconds",
        "completion_grace_seconds",
        "request_timeout_seconds",
        "max_attempts",
        "retry_initial_delay_seconds",
        "retry_backoff_multiplier",
        "retry_max_delay_seconds",
        "allow_t10_retry",
        "allow_completion_at_or_after_scheduled_start",
        "allow_completion_at_or_after_actual_start",
        "deadline_rule"
      ],
      "properties": {
        "target_cutoff_minutes": {
          "const": 60
        },
        "initial_start_tolerance_seconds": {
          "const": 30
        },
        "completion_grace_seconds": {
          "const": 300
        },
        "request_timeout_seconds": {
          "const": 60
        },
        "max_attempts": {
          "const": 3
        },
        "retry_initial_delay_seconds": {
          "const": 5
        },
        "retry_backoff_multiplier": {
          "const": 2
        },
        "retry_max_delay_seconds": {
          "const": 30
        },
        "allow_t10_retry": {
          "const": false
        },
        "allow_completion_at_or_after_scheduled_start": {
          "const": false
        },
        "allow_completion_at_or_after_actual_start": {
          "const": false
        },
        "deadline_rule": {
          "const": "min(cutoff_at + completion_grace, scheduled_start_at, actual_start_at_if_known)"
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poll_interval_seconds",
        "provisional_stability_seconds",
        "correction_recheck_interval_seconds",
        "correction_recheck_window_hours"
      ],
      "properties": {
        "poll_interval_seconds": {
          "const": 300
        },
        "provisional_stability_seconds": {
          "const": 1800
        },
        "correction_recheck_interval_seconds": {
          "const": 21600
        },
        "correction_recheck_window_hours": {
          "const": 168
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bulk_collection_enabled",
        "permission_policy",
        "max_requests_per_minute",
        "max_concurrency"
      ],
      "properties": {
        "bulk_collection_enabled": {
          "type": "boolean"
        },
        "permission_policy": {
          "type": "string",
          "minLength": 1
        },
        "max_requests_per_minute": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bulk_collection_enabled": {
                "const": true
              }
            },
            "required": [
              "bulk_collection_enabled"
            ]
          },
          "then": {
            "properties": {
              "permission_policy": {
                "$ref": "#/$defs/configuredString"
              },
              "max_requests_per_minute": {
                "type": "integer",
                "minimum": 1
              },
              "max_concurrency": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dry_run_evidence_max_age_hours",
        "dry_run_evidence_max_bytes"
      ],
      "properties": {
        "dry_run_evidence_max_age_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "dry_run_evidence_max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    }
  }
}
