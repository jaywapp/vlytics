{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vlytics:joint-score:1",
  "title": "Vlytics JointScoreDistributionV1",
  "description": "A finite, versioned probability mass function for final set score and both teams' match points.",
  "$comment": "The server semantic validator also enforces probability sums, derived marginals, volleyball score reachability, source-set marginal error, and distribution_id canonical hashing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "distribution_id",
    "model_version",
    "distribution_version",
    "config_id",
    "division",
    "ownership",
    "source_set_prediction",
    "verified_score_rule",
    "score_rules",
    "generation",
    "diagnostics",
    "source_set_score_probabilities",
    "entries",
    "marginals"
  ],
  "properties": {
    "schema_version": { "const": "joint-score-v1" },
    "distribution_id": { "$ref": "#/$defs/sha256" },
    "model_version": { "type": "string", "minLength": 1 },
    "distribution_version": { "type": "string", "minLength": 1 },
    "config_id": { "$ref": "#/$defs/sha256" },
    "division": { "enum": ["men", "women"] },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_variant_id", "input_snapshot_id"],
      "properties": {
        "producer_variant_id": { "type": "string", "minLength": 1 },
        "input_snapshot_id": { "type": "string", "minLength": 1 }
      }
    },
    "source_set_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_id",
        "producer_variant_id",
        "input_snapshot_id",
        "match_id",
        "schedule_revision_id",
        "prediction_cutoff_at",
        "model_version",
        "distribution_version",
        "config_id",
        "random_seed",
        "upstream_elo",
        "fitted_parameter_artifact_id",
        "training_cohort",
        "training_as_of",
        "training_result_manifest_sha256"
      ],
      "properties": {
        "prediction_id": { "$ref": "#/$defs/sha256" },
        "producer_variant_id": { "type": "string", "minLength": 1 },
        "input_snapshot_id": { "type": "string", "minLength": 1 },
        "match_id": { "type": "string", "minLength": 1 },
        "schedule_revision_id": { "type": "string", "minLength": 1 },
        "prediction_cutoff_at": { "type": "string", "format": "date-time" },
        "model_version": { "type": "string", "minLength": 1 },
        "distribution_version": { "type": "string", "minLength": 1 },
        "config_id": { "$ref": "#/$defs/sha256" },
        "random_seed": { "type": "integer" },
        "upstream_elo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prediction_id", "model_version", "config_id"],
          "properties": {
            "prediction_id": { "type": "string", "minLength": 1 },
            "model_version": { "type": "string", "minLength": 1 },
            "config_id": { "$ref": "#/$defs/sha256" }
          }
        },
        "fitted_parameter_artifact_id": { "$ref": "#/$defs/sha256" },
        "training_cohort": { "$ref": "#/$defs/trainingCohort" },
        "training_as_of": { "type": "string", "format": "date-time" },
        "training_result_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verified_score_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season_id",
        "division",
        "rule_version",
        "mirror_rule_artifact_id",
        "verified_at"
      ],
      "properties": {
        "season_id": { "type": "string", "minLength": 1 },
        "division": { "enum": ["men", "women"] },
        "rule_version": { "type": "string", "minLength": 1 },
        "mirror_rule_artifact_id": { "$ref": "#/$defs/sha256" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "score_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sets_to_win",
        "normal_target",
        "deciding_target",
        "win_by"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sets_to_win": { "const": 3 },
        "normal_target": { "type": "integer", "minimum": 2 },
        "deciding_target": { "type": "integer", "minimum": 2 },
        "win_by": { "const": 2 }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "random_seed",
        "sample_count",
        "sampler_version",
        "max_deuce_cycles",
        "configured_sample_count",
        "max_monte_carlo_set_marginal_error"
      ],
      "properties": {
        "method": { "enum": ["exact", "monte_carlo"] },
        "random_seed": { "type": "integer" },
        "sample_count": { "type": "integer", "minimum": 0 },
        "configured_sample_count": { "type": "integer", "minimum": 1 },
        "sampler_version": { "type": "string", "minLength": 1 },
        "max_deuce_cycles": { "type": "integer", "minimum": 0 },
        "max_monte_carlo_set_marginal_error": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "exact" } } },
          "then": { "properties": { "sample_count": { "const": 0 } } }
        },
        {
          "if": { "properties": { "method": { "const": "monte_carlo" } } },
          "then": { "properties": { "sample_count": { "minimum": 1 } } }
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_mass_error",
        "source_set_marginal_max_abs_error",
        "deuce_truncation_error_upper_bound",
        "maximum_conditional_set_tail_probability",
        "monte_carlo_max_standard_error_95"
      ],
      "properties": {
        "total_mass_error": { "$ref": "#/$defs/probability" },
        "source_set_marginal_max_abs_error": { "$ref": "#/$defs/probability" },
        "deuce_truncation_error_upper_bound": { "$ref": "#/$defs/probability" },
        "maximum_conditional_set_tail_probability": { "$ref": "#/$defs/probability" },
        "monte_carlo_max_standard_error_95": { "$ref": "#/$defs/probability" }
      }
    },
    "source_set_score_probabilities": { "$ref": "#/$defs/setScoreProbabilities" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["set_score", "home_points", "away_points", "probability"],
        "properties": {
          "set_score": { "enum": ["3:0", "3:1", "3:2", "2:3", "1:3", "0:3"] },
          "home_points": { "type": "integer", "minimum": 0 },
          "away_points": { "type": "integer", "minimum": 0 },
          "probability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "marginals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home_win_probability",
        "set_score_probabilities",
        "point_totals",
        "point_differentials"
      ],
      "properties": {
        "home_win_probability": { "$ref": "#/$defs/probability" },
        "set_score_probabilities": { "$ref": "#/$defs/setScoreProbabilities" },
        "point_totals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total_points", "probability"],
            "properties": {
              "total_points": { "type": "integer", "minimum": 0 },
              "probability": { "$ref": "#/$defs/probability" }
            }
          }
        },
        "point_differentials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point_differential", "probability"],
            "properties": {
              "point_differential": { "type": "integer" },
              "probability": { "$ref": "#/$defs/probability" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "trainingCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "division",
        "availability_policy",
        "competition",
        "stage",
        "timing_eligibility",
        "result_finality_policy",
        "input_version",
        "franchise_mapping_version"
      ],
      "properties": {
        "division": { "enum": ["men", "women"] },
        "availability_policy": { "type": "string", "minLength": 1 },
        "competition": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "timing_eligibility": { "type": "string", "minLength": 1 },
        "result_finality_policy": { "type": "string", "minLength": 1 },
        "input_version": { "type": "string", "minLength": 1 },
        "franchise_mapping_version": { "type": "string", "minLength": 1 }
      }
    },
    "setScoreProbabilities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/outcome30" },
        { "$ref": "#/$defs/outcome31" },
        { "$ref": "#/$defs/outcome32" },
        { "$ref": "#/$defs/outcome23" },
        { "$ref": "#/$defs/outcome13" },
        { "$ref": "#/$defs/outcome03" }
      ],
      "items": false
    },
    "outcomeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "probability"],
      "properties": {
        "outcome": { "type": "string" },
        "probability": { "$ref": "#/$defs/probability" }
      }
    },
    "outcome30": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "3:0" } } }
      ]
    },
    "outcome31": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "3:1" } } }
      ]
    },
    "outcome32": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "3:2" } } }
      ]
    },
    "outcome23": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "2:3" } } }
      ]
    },
    "outcome13": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "1:3" } } }
      ]
    },
    "outcome03": {
      "allOf": [
        { "$ref": "#/$defs/outcomeBase" },
        { "properties": { "outcome": { "const": "0:3" } } }
      ]
    }
  }
}
